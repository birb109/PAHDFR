# Hidden archive provider configuration.
# Supported values: wayback, commoncrawl, arquivo, cdx
HDFR_ARCHIVE_PROVIDER=wayback
# Leave blank for each provider's default API. For Common Crawl, use a crawl ID
# below to pin a reproducible collection index; blank selects the current latest.
HDFR_ARCHIVE_API_BASE_URL=
HDFR_COMMONCRAWL_INDEX=
# Optional; use only if the selected provider requires CDX cookie authentication.
HDFR_ARCHIVE_API_KEY=
# Required only for a custom CDX-compatible provider. Placeholders:
# HDFR_CAPTURE_URL_TEMPLATE=https://archive.example/web/{timestamp}/{original_url}
HDFR_CAPTURE_URL_TEMPLATE=
